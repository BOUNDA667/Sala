// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Le modèle User représente les utilisateurs de l'application.
/// Il contient des informations de base, ainsi que des champs pour la gestion premium.
model User {
  id              Int           @id @default(autoincrement())
  firstName       String?
  lastName        String?
  username        String        @unique
  email           String        @unique
  password        String
  emailVerified   Boolean       @default(false)
  phone           String?       @unique
  phoneVerified   Boolean       @default(false)
  blocked         Boolean       @default(false)
  isPremium       Boolean       @default(false)        // Indique si l'utilisateur a souscrit à un abonnement premium.
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relation optionnelle vers un abonnement (subscription)
  subscription    Subscription? @relation(fields: [subscriptionId], references: [id])
  subscriptionId  Int?

  // Relations vers les tâches, commentaires et notifications de l'utilisateur
  todos           Todo[]
  comments        Comment[]
  notifications   Notification[]
}

/// Le modèle Subscription gère les informations relatives aux abonnements premium.
/// On peut stocker ici le plan choisi, la date de début et éventuellement la date de fin.
model Subscription {
  id         Int       @id @default(autoincrement())
  plan       String    // Par exemple: "free", "premium", "enterprise", etc.
  startDate  DateTime  @default(now())
  endDate    DateTime? // Date de fin d'abonnement, le cas échéant.

  // Relation inverse : un abonnement peut être associé à plusieurs utilisateurs si besoin.
  // Pour un usage 1:1, on peut gérer l'unicité côté applicatif.
  users      User[]
}

/// Le modèle Todo représente une tâche à réaliser.
/// Il inclut des informations sur le titre, la description, le statut, la priorité et des dates associées.
model Todo {
  id          Int         @id @default(autoincrement())
  title       String
  description String?
  completed   Boolean     @default(false)
  priority    Priority    @default(MEDIUM)   // Priorité de la tâche
  dueDate     DateTime?                      // Date limite de réalisation
  reminderDate    DateTime?                      // Date pour envoyer un rappel
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Relation avec l'utilisateur qui possède cette tâche.
  user        User        @relation(fields: [userId], references: [id])
  userId      Int

  // Relation many-to-many avec les tags (implémentée implicitement par Prisma)
  tags        Tag[]

  // Relation vers les commentaires liés à cette tâche
  comments    Comment[]
}

/// Enumération pour définir la priorité d'une tâche.
enum Priority {
  LOW
  MEDIUM
  HIGH
}

/// Le modèle Tag permet d'associer des étiquettes aux tâches afin de faciliter le classement ou la recherche.
model Tag {
  id    Int    @id @default(autoincrement())
  name  String @unique

  // Relation many-to-many implicite avec Todo
  todos Todo[]
}

/// Le modèle Comment permet aux utilisateurs de commenter des tâches.
model Comment {
  id        Int      @id @default(autoincrement())
  content   String
  createdAt DateTime @default(now())

  // Relation vers l'utilisateur qui a posté le commentaire.
  user      User     @relation(fields: [userId], references: [id])
  userId    Int

  // Relation vers la tâche commentée.
  todo      Todo     @relation(fields: [todoId], references: [id])
  todoId    Int
}

/// Le modèle Notification permet de gérer les notifications envoyées aux utilisateurs.
model Notification {
  id        Int      @id @default(autoincrement())
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  // Relation vers l'utilisateur destinataire de la notification.
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
}
